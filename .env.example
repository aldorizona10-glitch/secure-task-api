# Copy to .env for local dev. In production, set these as real env vars.
APP_NAME=SecureTask API
ENV=development

# CHANGE THIS in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev-only-insecure-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite by default; for Postgres: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./securetask.db

RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=5/minute
CORS_ORIGINS=*
